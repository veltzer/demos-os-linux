{
  // htmlhint config, shared fleet-wide (rsmultigit check-same).
  //
  // This is htmlhint's default ruleset, spelled out. It has to be: a
  // .htmlhintrc REPLACES the defaults rather than amending them, so a file
  // that names one rule silently switches every other rule off. Spelling
  // them all out makes "turn one rule off" a one-line edit that keeps the
  // other nine. An empty {} would also mean "defaults", but says nothing.
  "tagname-lowercase": true,
  "attr-lowercase": true,
  "attr-value-double-quotes": true,
  "doctype-first": true,
  "tag-pair": true,
  "spec-char-escape": true,
  "id-unique": true,
  "src-not-empty": true,
  "attr-no-duplication": true,
  "title-require": true
}
